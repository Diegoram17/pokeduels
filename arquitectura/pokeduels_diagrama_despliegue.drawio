        <mxCell id="c_spa" value="&amp;laquo;component&amp;raquo;&lt;br&gt;&lt;b&gt;:SPA PokeDuels&lt;/b&gt;&lt;br&gt;React 19 + Router 6 + socket.io-client&lt;br&gt;estado en memoria + localStorage (pokeduels:mockState)" style="shape=component;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fontSize=11;fillColor=#f4dcc5;strokeColor=#c69c6d;" vertex="1" parent="1">
