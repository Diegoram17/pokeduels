<mxfile host="app.diagrams.net">
  <diagram name="PokeDuels - Modelo de despliegue (asignacion)" id="pokeduels-deploy">
    <mxGraphModel dx="2400" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="900" background="light-dark(#ffffff, #121212)" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;PokeDuels — Modelo de despliegue&lt;/b&gt;  (SPA en Vercel · backend monoproceso en Render · PostgreSQL en Neon)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="26" as="geometry" />
        </mxCell>

        <!-- ============ Vercel ============ -->
        <mxCell id="n_vercel" value="&amp;laquo;device&amp;raquo;  Vercel — Edge / CDN estatico" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundColor=#dae8fc;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;size=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="360" height="180" as="geometry" />
        </mxCell>
        <mxCell id="a_dist" value="&amp;laquo;artifact&amp;raquo;&lt;br&gt;&lt;b&gt;frontend/dist/&lt;/b&gt;&lt;br&gt;index.html + JS + CSS + assets&lt;br&gt;(vite build, deploy auto en push a master)" style="shape=component;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fontSize=11;fillColor=#f4dcc5;strokeColor=#c69c6d;" vertex="1" parent="1">
          <mxGeometry x="70" y="120" width="300" height="100" as="geometry" />
        </mxCell>

        <!-- ============ Render ============ -->
        <mxCell id="n_render" value="&amp;laquo;device&amp;raquo;  Render — Web Service  (Node 20, free tier · 1 proceso: node server.js)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundColor=#dae8fc;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;size=14;" vertex="1" parent="1">
          <mxGeometry x="470" y="70" width="520" height="320" as="geometry" />
        </mxCell>
        <mxCell id="c_express" value="&amp;laquo;component&amp;raquo;&lt;br&gt;&lt;b&gt;:Express API&lt;/b&gt;&lt;br&gt;REST: /api/session, /api/rooms, /api/pokemons, /health" style="shape=component;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fontSize=11;fillColor=#ffe599;strokeColor=#d6b656;" vertex="1" parent="1">
