        <mxCell id="cx4" value="&amp;laquo;TCP/TLS 5432&amp;raquo;  pool pg  (DATABASE_URL)" style="html=1;endArrow=open;endFill=0;fontSize=11;fontStyle=1;" edge="1" parent="1" source="c_pool" target="d_db">
