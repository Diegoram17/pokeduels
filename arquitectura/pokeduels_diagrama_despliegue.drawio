        </mxCell>
        <mxCell id="cx5" value="&amp;laquo;HTTPS&amp;raquo;  GET /health  (ADR-0006, evita el spin-down del free tier)" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;fontStyle=2;" edge="1" parent="1" source="c_ping" target="c_express">
          <mxGeometry relative="1" as="geometry" />
