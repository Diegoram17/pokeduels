        </mxCell>
        <mxCell id="c_sio" value="&amp;laquo;component&amp;raquo;&lt;br&gt;&lt;b&gt;:Socket.IO Server&lt;/b&gt;&lt;br&gt;WSS · handshake touchSession · room/team/duel handlers" style="shape=component;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fontSize=11;fillColor=#ffe599;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="500" y="230" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c_engine" value="&amp;laquo;component&amp;raquo;&lt;br&gt;&lt;b&gt;:Motor de duelo&lt;/b&gt;&lt;br&gt;engine/ + turnCycle + tournamentLifecycle&lt;br&gt;estado de fases en memoria (phaseStore / roundState)" style="shape=component;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fontSize=11;fillColor=#ffe599;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="800" y="175" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c_pool" value="&amp;laquo;component&amp;raquo;&lt;br&gt;&lt;b&gt;:Pg Pool (db/pool.js)&lt;/b&gt;" style="shape=component;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
