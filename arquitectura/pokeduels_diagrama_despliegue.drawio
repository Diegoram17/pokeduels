        <mxCell id="cx2" value="&amp;laquo;HTTPS&amp;raquo;  REST /api/*  (bearer sessionToken)" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;fontStyle=1;" edge="1" parent="1" source="c_spa" target="c_express">
