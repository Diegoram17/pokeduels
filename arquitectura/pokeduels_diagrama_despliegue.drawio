        <!-- ============ Conexiones ============ -->
        <mxCell id="cx1" value="&amp;laquo;HTTPS&amp;raquo;  carga inicial del SPA" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;fontStyle=1;" edge="1" parent="1" source="c_spa" target="a_dist">
