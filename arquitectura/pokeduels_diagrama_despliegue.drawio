        <mxCell id="c_ping" value="&amp;laquo;script&amp;raquo; ping periodico" style="shape=component;whiteSpace=wrap;html=1;align=center;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
