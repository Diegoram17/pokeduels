        <!-- ============ Neon ============ -->
        <mxCell id="n_neon" value="&amp;laquo;device&amp;raquo;  Neon — PostgreSQL serverless" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundColor=#dae8fc;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;size=14;" vertex="1" parent="1">
