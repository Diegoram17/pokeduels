{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate:up": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:down": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down 0",
    "migrate:create": "node-pg-migrate create",
    "preseed": "node ../scripts/sync-seed-data.mjs",
    "seed": "node --env-file=.env seed/index.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "node-pg-migrate": "^7",
    "pg": "^8",
    "socket.io": "^4"
  },
  "devDependencies": {
    "socket.io-client": "^4",
    "supertest": "^7.2.2",
    "vitest": "^4"
  }
}
